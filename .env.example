DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=receiptor_db
# true for TiDB Cloud / hosted MySQL (TiDB also uses DB_PORT=4000). Leave unset for local MySQL.
DB_SSL=
# Set NODE_ENV=production on the production server.
NODE_ENV=development
# Lets TypeORM auto-alter the schema in dev only (ignored when NODE_ENV=production).
# Leave unset/false against a database with real data; run migrations/*.sql instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false
PORT=3000
# Comma-separated frontend origins allowed to call the API cross-origin.
# Leave unset when the frontend is served from the same origin (or via the Vite dev proxy).
CORS_ORIGIN=
# Number of reverse-proxy hops in front of the server (e.g. 1 behind nginx/Render/Heroku).
# Needed so rate limiting sees the real client IP. Leave unset when not behind a proxy.
TRUST_PROXY=
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Cloudinary (business logo storage) - from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, defaults to receiptor/logos
CLOUDINARY_FOLDER=receiptor/logos
CLOUDINARY_BLOG_FOLDER=receiptor/blog
# Support form email. Option 1 - Brevo HTTP API (use this on Render free, which blocks SMTP):
# brevo.com > SMTP & API > API Keys. BREVO_SENDER must be verified under Senders & IP.
BREVO_API_KEY=
BREVO_SENDER=
# Option 2 - SMTP (used when BREVO_API_KEY is empty). For Gmail: turn on 2-Step Verification,
# then create an App Password (Google Account > Security > App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives support messages (can be the same as SMTP_USER)
SUPPORT_INBOX=
# Optional sender, defaults to "Quick Receipt Support" <SMTP_USER>
SMTP_FROM=

# Accounts (login emails, comma-separated) that can publish blog posts and announcements.
ADMIN_EMAILS=
